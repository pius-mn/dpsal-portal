{
  "doctype": "DocType",
  "name": "Client Document Master",
  "module": "Audit Portal",
  "autoname": "field:document_title",
  "naming_rule": "By fieldname",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_rename": 1,
  "title_field": "document_title",
  "show_title_field_in_link": 1,
  "field_order": [
    "document_title",
    "doc_type",
    "is_required",
    "has_expiry",
    "column_break_details",
    "issuing_authority",
    "short_alias",
    "description"
  ],
  "fields": [
    {
      "fieldname": "document_title",
      "fieldtype": "Data",
      "label": "Document Title",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "doc_type",
      "fieldtype": "Select",
      "label": "Document Category",
      "options": "\nStatutory\nAdministrative\nContract\nLicence\nKYC\nID/Passport\nReport\nOther",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "is_required",
      "fieldtype": "Check",
      "label": "Required by Default",
      "default": "1"
    },
    {
      "fieldname": "has_expiry",
      "fieldtype": "Check",
      "label": "Has Expiry Date",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_details",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "issuing_authority",
      "fieldtype": "Data",
      "label": "Default Issuing Authority"
    },
    {
      "fieldname": "short_alias",
      "fieldtype": "Data",
      "label": "Short Reference / Code"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Audit Document Reviewer",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    }
  ]
}
