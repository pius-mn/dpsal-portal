{
  "doctype": "DocType",
  "name": "Client Bank Account",
  "module": "Audit Portal",
  "engine": "InnoDB",
  "istable": 1,
  "track_changes": 1,
  "field_order": [
    "bank_name",
    "account_number",
    "branch_name",
    "branch_address",
    "branch_email",
    "branch_phone",
    "account_type",
    "sub_category",
    "currency",
    "swift_bic",
    "operation_method",
    "signatories",
    "date_open",
    "date_close",
    "rel_manager",
    "rel_email",
    "rel_mobile",
    "has_online",
    "online_limit",
    "online_timing",
    "limits"
  ],
  "fields": [
    {"fieldname": "bank_name", "fieldtype": "Data", "label": "Bank", "reqd": 1, "in_list_view": 1},
    {"fieldname": "account_number", "fieldtype": "Data", "label": "Account number"},
    {"fieldname": "branch_name", "fieldtype": "Data", "label": "Branch"},
    {"fieldname": "branch_address", "fieldtype": "Small Text", "label": "Branch address"},
    {"fieldname": "branch_email", "fieldtype": "Data", "label": "Branch email", "options": "Email"},
    {"fieldname": "branch_phone", "fieldtype": "Data", "label": "Branch phone"},
    {"fieldname": "account_type", "fieldtype": "Select", "label": "Account type", "options": "\nChecking\nSaving\nCurrent\nOther"},
    {"fieldname": "sub_category", "fieldtype": "Select", "label": "Account category", "options": "\nMain\nSub"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency"},
    {"fieldname": "swift_bic", "fieldtype": "Data", "label": "SWIFT/BIC"},
    {"fieldname": "operation_method", "fieldtype": "Select", "label": "Signing arrangement", "options": "\nJointly\nSeverally"},
    {"fieldname": "signatories", "fieldtype": "Small Text", "label": "Authorized signatories"},
    {"fieldname": "date_open", "fieldtype": "Date", "label": "Date opened"},
    {"fieldname": "date_close", "fieldtype": "Date", "label": "Date closed"},
    {"fieldname": "rel_manager", "fieldtype": "Data", "label": "Relationship manager"},
    {"fieldname": "rel_email", "fieldtype": "Data", "label": "Manager email", "options": "Email"},
    {"fieldname": "rel_mobile", "fieldtype": "Data", "label": "Manager phone"},
    {"fieldname": "has_online", "fieldtype": "Select", "label": "Online banking available", "options": "\nYes\nNo"},
    {"fieldname": "online_limit", "fieldtype": "Currency", "label": "Online transaction limit"},
    {"fieldname": "online_timing", "fieldtype": "Data", "label": "Online limit period"},
    {"fieldname": "limits", "fieldtype": "Currency", "label": "Account transaction limit"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Audit Client", "read": 1}
  ]
}
